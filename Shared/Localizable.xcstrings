            "value" : "尚未"
          }
        }
      }
    },
    "Nothing about you, your pictures or how you use the app is collected, sent to the developer, or shared with anyone." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与你本人、你的图片或你如何使用本 App 有关的任何信息，都不会被收集、发送给开发者或与任何人共享。"
          }
        }
      }
    },
    "Nothing is collected or sent anywhere. Pictures stay on your iPhone and Apple Watch, and only move between the two." : {
      "localizations" : {
