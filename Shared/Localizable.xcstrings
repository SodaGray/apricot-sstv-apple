    },
    "First Day" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第一天"
          }
        }
      }
    },
    "Fit Whole Photo" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完整显示照片"
          }
        }
      }
    },
    "Fitted to the Syncs" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按同步脉冲拟合"
          }
        }
      }
    },
    "Found %lld pictures and %lld fragments." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找到 %1$lld 张图片和 %2$lld 个片段。"
          }
        }
      }
    },
    "Fragment · %lld rows" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Fragment · %lld row"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Fragment · %lld rows"
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
