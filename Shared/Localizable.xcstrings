      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时钟"
          }
        }
      }
    },
    "Clock Error" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时钟偏差"
          }
        }
      }
    },
    "Color Bars" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彩条"
          }
        }
      }
    },
    "Complete" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完整"
          }
        }
      }
    },
    "Connect the audio" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接音频"
          }
        }
      }
    },
    "Connect the iPhone's audio output (a headphone adapter or a USB audio interface) to the radio's microphone or data input, and turn on VOX. Raise the level until the radio's ALC just begins to move." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 iPhone 的音频输出（耳机转接头或 USB 声卡）接到电台的话筒或数据输入，并打开 VOX。把电平调到电台的 ALC 刚开始动作即可。"
          }
        }
      }
    },
    "Connect the radio" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接电台"
          }
        }
      }
    },
    "Continue" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续"
          }
        }
      }
    },
    "Could not write image.png" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法写入 image.png"
          }
        }
      }
    },
    "Couldn't Make the WAV" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
