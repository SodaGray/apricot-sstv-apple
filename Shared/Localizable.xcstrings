            "value" : "当前活动"
          }
        }
      }
    },
    "Custom" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义"
          }
        }
      }
    },
    "Darkroom" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗室"
          }
        }
      }
    },
    "Decode Audio File" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解码音频文件"
          }
        }
      }
    },
    "Decode Audio File, in the ⋯ menu on Receive, finds the pictures in a recording (WAV, M4A, MP3 and others). Each keeps its stretch of the recording as raw audio. When they were received is worked out from the file's date." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“接收”页 ⋯ 菜单里的“解码音频文件”可以从录音（WAV、M4A、MP3 等）中找出图片。每张图片都带着录音中属于它的那一段作为原始音频。接收时间根据文件日期推算。"
          }
        }
      }
    },
    "Decode Audio File…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解码音频文件…"
          }
        }
      }
    },
    "Decoded from the audio file “%@”, at %@ into it." : {
      "localizations" : {
        "zh-Hans" : {
