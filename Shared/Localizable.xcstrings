    "Cancel" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消"
          }
        }
      }
    },
    "Center" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "居中"
          }
        }
      }
    },
    "Change Picture" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更换图片"
          }
        }
      }
    },
    "Check before going on the air" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发射前先检查"
          }
        }
      }
    },
    "Check that the Level bar moves, that Mode is Automatic or matches the picture, and that the tuning marker sits near 1900 Hz during the VIS header. Weak or distorted audio can hide the header; Start Without VIS helps." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查电平条是否在动、模式是否为“自动”或与图片一致，以及 VIS 头期间调谐标记是否在 1900 Hz 附近。音频太弱或失真可能听不出 VIS 头，这时“无 VIS 也开始”会有帮助。"
          }
        }
      }
    },
    "Choose a Picture" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择图片"
          }
        }
      }
    },
    "Choose a picture to send." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一张要发送的图片。"
          }
        }
      }
    },
    "Choose All Pictures in the menu at the top right." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在右上角的菜单中选择“全部图片”。"
          }
        }
      }
    },
    "Choose Picture" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择图片"
          }
        }
      }
    },
    "Choosing a mode" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择模式"
          }
        }
      }
    },
    "Clear Picture" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
