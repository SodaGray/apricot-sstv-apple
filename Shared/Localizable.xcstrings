    "Keep the Level bar in the green, between −40 and −10 dB. If it turns red and says Clipping, turn the radio down." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让电平条保持在绿色区域，即 −40 到 −10 dB 之间。如果变红并显示“削波”，请调小电台音量。"
          }
        }
      }
    },
    "Keep While Dimmed" : {
      "localizations" : {
