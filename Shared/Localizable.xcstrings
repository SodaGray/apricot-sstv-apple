    "Receive slow-scan television pictures from a radio on your iPhone or Apple Watch, and send your own from your iPhone." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 或 Apple Watch 上接收电台传来的慢扫描电视（SSTV）图片，也可以用 iPhone 发送你自己的图片。"
          }
        }
