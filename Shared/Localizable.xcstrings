          }
        }
      }
    },
    "Fragments" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片段"
          }
        }
      }
    },
    "Fragments are too short to count as pictures, but their raw audio may hold a whole picture. Pictures are not affected." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片段太短，算不上图片，但它们的原始音频里可能有整张图。图片不受影响。"
          }
        }
      }
    },
    "Free Software" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自由软件"
